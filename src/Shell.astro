---
/**
 * The shell of every page on swavely.lol, the Hub's and every Tool's (ADR-0004), so
 * moving between them changes nothing but the page. No bar: a settings cog sits in the
 * top right, and its menu holds who is signed in, the theme, People for a Hub Admin, and
 * sign in or out (always the Hub's). Pages other than the Shelf get a small way home in
 * the top left, and a Tool's pages its name beside it. Textile finish, lol skin; light
 * or dark from the device, or the choice saved in the menu (Liquid Textile's `lt-theme`).
 * Its forms keep your place: a post neither loses what was typed nor jumps to the top
 * (`forms.ts`, with `formRedirect` in the guard on the server).
 *
 * The page imports its own stylesheet, which imports `@swavely-lol/kit/styles/shell.css`.
 */
import type { Viewer } from './contract';

interface Props {
  title: string;
  /** Where the Hub is: '' in production and in the Hub, HUB_ORIGIN in a Tool's dev. */
  hub?: string;
  /** A Tool's name beside the way home ("move"), linking to its front page. */
  tool?: { label: string; href: string };
  /** The sign-in pages: no way home, no sign-in item. */
  bare?: boolean;
  /** The Shelf and Open Tools alone (ADR-0002); every other page asks search engines to stay out. */
  indexed?: boolean;
  /** A wider page, for the Shelf. */
  wide?: boolean;
  /** The Shelf: no way home, since it is home. */
  home?: boolean;
  description?: string;
  /** For `indexed` pages: the canonical URL. */
  canonical?: string;
}
const { title, hub = '', tool, bare = false, indexed = false, wide = false, home = false, description, canonical } = Astro.props;
const viewer = (Astro.locals as { viewer?: Viewer }).viewer;
const fullTitle = title === 'swavely.lol' ? title : `${title} · swavely.lol`;
const at = (path: string) => hub + path;
---

<!doctype html>
<html lang="en" data-theme="light" data-finish="textile">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={indexed ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    {indexed && canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
      </>
    )}
    <link rel="icon" href={at('/favicon/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={at('/favicon/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={at('/favicon/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={at('/favicon/apple-touch-icon.png')} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('lt-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      {!home && !bare && (
        <span class="home-link">
          <a class="home-mark" href={at('/')}><img src={at('/favicon/android-chrome-192x192.png')} alt="" width="22" height="22" />swavely.lol</a>
          {tool && <a class="home-tool" href={tool.href}>/ {tool.label}</a>}
        </span>
      )}
      <div class="settings">
        <button type="button" class="lt-btn lt-btn-ghost lt-btn-icon" id="settings-btn" aria-label="Settings">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg>
        </button>
        <div class="lt-popover lt-menu" id="settings-menu">
          {viewer && <div class="lt-menu-label">Signed in as {viewer.name}</div>}
          <button type="button" class="lt-menu-item" data-action="theme">Dark mode</button>
          {viewer?.isHubAdmin && <a class="lt-menu-item" href={at('/people')}>People</a>}
          {!home && <a class="lt-menu-item" href={at('/')}>Back to the shelf</a>}
          {(viewer || !bare) && <hr class="lt-menu-divider" />}
          {viewer
            ? <button type="button" class="lt-menu-item" data-action="signout">Sign out</button>
            : !bare && <a class="lt-menu-item" href={at(`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`)}>Sign in</a>}
        </div>
        <form method="post" action={at('/logout')} id="signout-form" hidden></form>
      </div>
      <main class={wide ? 'wide' : undefined}>
        <slot />
      </main>
    </div>
    <script>
      import { menu } from '../styles/liquid-textile/behaviors.js';
      import { enhanceForms } from './forms';

      enhanceForms();

      const root = document.documentElement;
      const themeItem = document.querySelector<HTMLButtonElement>('[data-action="theme"]')!;
      const label = () => { themeItem.textContent = root.getAttribute('data-theme') === 'dark' ? 'Light mode' : 'Dark mode'; };
      label();

      menu(document.getElementById('settings-btn'), document.getElementById('settings-menu'), {
        align: 'end',
        onSelect: (picked?: unknown) => {
          const item = picked as HTMLElement;
          if (item.dataset.action === 'theme') {
            const t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', t);
            try { localStorage.setItem('lt-theme', t); } catch {}
            label();
          } else if (item.dataset.action === 'signout') {
            (document.getElementById('signout-form') as HTMLFormElement).submit();
          } else if (item instanceof HTMLAnchorElement) {
            location.href = item.href;
          }
        },
      });
    </script>
  </body>
</html>
